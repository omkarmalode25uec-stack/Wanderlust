<% layout("/layouts/boilerplate") %>

    <body>
        <br><br>
        <div class="row">
            <div class="col-8 offset-2">

                <div class="container mt-4">

                    <h1 class="mb-4">Create a New Listing</h1>

                    <form action="/listings" method="post" novalidate class="needs-validation" enctype="multipart/form-data">

                        <!-- Title -->
                        <div class="mb-3">
                            <label for="title" class="form-label">Title</label>
                            <textarea name="listing[title]" placeholder="enter title"
                                class="form-control" required></textarea>
                            
                       </div>

                        <!-- Description -->
                        <div class="mb-3">
                            <label for="description" class="form-label" >Description</label>
                            <textarea name="listing[description]" placeholder="enter description"
                                class="form-control" required></textarea>
                        </div>

                        <!-- Image -->
                        <div class="mb-3">
                            <label for="image" class="form-label">Upload Image</label>
                            <input name="listing[image]" type="file"
                                class="form-control">
                        </div>

                        <!-- Price + Country -->
                        <div class="row">

                            <div class="mb-3 col-md-4">
                                <label for="price" class="form-label">Price</label>
                                <input name="listing[price]" placeholder="enter price" 
                                    class="form-control" required>
                            </div>

                            <div class="mb-3 col-md-8">
                                <label for="country" class="form-label">Country</label>
                                <input name="listing[country]" placeholder="enter country" type="text"
                                    class="form-control" required>
                            </div>

                        </div>

                        <!-- Location -->
                        <div class="mb-3">
                            <label for="location" class="form-label">Location</label>
                            <input name="listing[location]" placeholder="enter location" type="text"
                                class="form-control" required>
                        </div>

                        <!-- Add Button -->
                        <button class="btn btn-dark addbtn">
                            Add
                        </button>

                    </form>

                </div>

            </div>
        </div>
        <br><br>
    </body>